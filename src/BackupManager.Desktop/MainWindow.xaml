<Window x:Class="BackupManager.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Backup Manager" Height="760" Width="1240" WindowStartupLocation="CenterScreen" Background="#F5F7FB">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,5"/><Setter Property="Padding" Value="14,10"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D9E2EC"/><Setter Property="Foreground" Value="#183B62"/></Style>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="#E8F3FF"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,10"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="navBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="navBorder" Property="Background" Value="#0A3158"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="navBorder" Property="Background" Value="#071F38"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="navBorder" Property="Background" Value="#0A3158"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#1677C8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="primaryBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="primaryBorder" Property="Background" Value="#0F5FA4"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="primaryBorder" Property="Background" Value="#0A467A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="primaryBorder" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="PauseButton" TargetType="Button"><Setter Property="Background" Value="#F59E0B"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="pauseBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pauseBorder" Property="Background" Value="#D97706"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="pauseBorder" Property="Background" Value="#B45309"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGrid"><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="44"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="Background" Value="White"/><Setter Property="CanUserResizeRows" Value="False"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EEF4FA"/><Setter Property="Foreground" Value="#35516F"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#DCE6F0"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  </Window.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#142F4C" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="BACKUP MANAGER" Foreground="#9FD2FF" FontWeight="Bold"/><TextBlock Text="Server protection" Foreground="White" FontSize="23" Margin="0,8,0,26"/></StackPanel><StackPanel><Button Style="{StaticResource NavButton}" Content="Dashboard" Tag="Dashboard" Click="Navigate"/><Button Style="{StaticResource NavButton}" Content="Backup Jobs" Tag="Jobs" Click="Navigate"/><Button Style="{StaticResource NavButton}" Content="Backup Sources" Tag="Sources" Click="Navigate"/><Button Style="{StaticResource NavButton}" Content="Backup Schedule" Tag="Schedule" Click="Navigate"/><Button Style="{StaticResource NavButton}" Content="Remote Storage" Tag="Remote" Click="Navigate"/><Button Style="{StaticResource NavButton}" Content="Backup History" Tag="History" Click="Navigate"/><Button Style="{StaticResource NavButton}" Content="Logs" Tag="Logs" Click="Navigate"/><Button Style="{StaticResource NavButton}" Content="Settings" Tag="Settings" Click="Navigate"/></StackPanel></DockPanel></Border>
    <Grid Grid.Column="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="30" FontWeight="SemiBold" Foreground="#142A43"/><TextBlock x:Name="PageSubtitle" Text="Monitor and control protection for this server" Foreground="#64748B" Margin="0,4,0,18"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="RunBackupButton" Content="Run Backup and Upload Now" Style="{StaticResource PrimaryButton}" Click="RunNow"/><Button x:Name="PauseButton" Content="Pause" Style="{StaticResource PauseButton}" Click="TogglePause"/></StackPanel></DockPanel><Border Grid.Row="1" Background="White" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="10" Padding="22"><ContentControl x:Name="PageContent"/></Border></Grid>
    <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="#B3142438" Visibility="Collapsed"><Border Width="520" MinHeight="170" Padding="26" Background="White" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="BusyMessage" Text="Processing…" FontSize="17" FontWeight="SemiBold" Foreground="#142A43" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/><TextBlock Text="Please keep Backup Manager open while this finishes." Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,18"/><ProgressBar Height="6" IsIndeterminate="True" Foreground="#1677C8" Background="#E6EEF6"/></StackPanel></Border></Grid>
  </Grid>
</Window>
